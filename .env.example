# Environment Variables Configuration for Personal Finance Manager

# Neon PostgreSQL Database Connection (Pooled)
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct Database Connection (Used by Prisma migrations)
DIRECT_URL="postgresql://neondb_owner:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth Secret
BETTER_AUTH_SECRET="your-better-auth-secret-here"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend Email Delivery Configuration (Password recovery)
RESEND_API_KEY="re_123456789_your_resend_api_key_here"
EMAIL_FROM="Finance Manager <onboarding@resend.dev>"

